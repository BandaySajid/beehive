# The local demo creates its own private signer and deploys a Hardhat registry.
# Run npm install && npm run setup:demo && npm run dev.
# No external account, testnet tokens or LLM credentials are required locally.

# Production/testnet deployment only; do not use a live/mainnet key.
APP_URL=https://beehive.pages.dev
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CONTRACT_ADDRESS=
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
NETWORK_NAME=Ethereum Sepolia
# Store only in a Worker secret or an ignored local environment file.
BLOCKCHAIN_PRIVATE_KEY=
# Leave VITE_API_URL unset with the same-origin Pages proxy.
# VITE_API_URL=https://api.your-domain.example
DEMO_MODE=false
